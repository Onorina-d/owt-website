---
/** Sticky in-page navigation for long service pages. */
interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
---

<nav class="subnav" aria-label="Розділи сторінки" data-subnav>
  <div class="container subnav__inner">
    <ol class="subnav__list">
      {
        items.map((it, i) => (
          <li>
            <a href={`#${it.id}`} data-subnav-link>
              <span class="mono">{String(i + 1).padStart(2, '0')}</span>
              {it.label}
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</nav>

<style>
  .subnav {
    position: sticky;
    top: 0;
    transition: top var(--dur-2) var(--ease-out);
    z-index: 40;
    background: var(--paper);
    border-block: 1px solid var(--rule-on-paper);
  }
  /* html.header-visible is toggled by the header script (no document-wide :has()) */
  :global(html.header-visible) .subnav {
    top: var(--header-h);
  }
  .subnav__inner {
    overflow-x: auto;
    scrollbar-width: none;
  }
  .subnav__inner::-webkit-scrollbar {
    display: none;
  }
  .subnav__list {
    display: flex;
    gap: 6px;
    padding-block: 10px;
    width: max-content;
  }
  .subnav a {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    min-height: 44px;
    align-items: center;
    padding: 0 18px;
    border-radius: var(--radius-o);
    font-size: 0.9375rem;
    font-weight: 450;
    white-space: nowrap;
    color: var(--on-paper-muted);
    transition:
      background-color var(--dur-1),
      color var(--dur-1);
  }
  .subnav a .mono {
    color: inherit;
    opacity: 0.7;
  }
  .subnav a:hover {
    color: var(--ink);
    background: var(--paper-2);
  }
  .subnav a[aria-current='true'] {
    color: var(--paper);
    background: var(--ink);
  }
</style>
