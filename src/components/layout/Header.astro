---
/**
 * Header: transparent over the hero (light content), solid paper once the page
 * scrolls past it; hides on scroll down and returns on scroll up.
 * Mobile: logo + menu button opening a full-screen editorial menu.
 */
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import { phones, messengers } from '../../data/site';
import { routes, directionLinks } from '../../data/routes';
import { getDict, homePath, type Locale } from '../../i18n';
import { withBase, stripBase } from '../../lib/paths';

interface Props {
  locale: Locale;
  /** 'over' = transparent over a dark hero / page head; 'solid' = paper bar from the start */
  tone?: 'over' | 'solid';
}
const { locale, tone = 'over' } = Astro.props;
const t = getDict(locale);
const other: Locale = locale === 'uk' ? 'en' : 'uk';
const path = Astro.url.pathname;
const isHome = path === homePath(locale);
const isCurrent = (href: string) => !href.startsWith('#') && href !== withBase('/') && path.startsWith(href);
const is404 = stripBase(path).startsWith('/404');
const requestHref = isHome ? '#request' : routes.request();
const servicesSub = locale === 'uk' ? [...directionLinks, { id: 'fleet', href: routes.fleet, label: 'Оренда техніки' }] : [];
---

<header class="header" data-header data-state={tone === 'over' ? 'top' : 'solid'} data-tone={tone}>
  <div class="header__bar container">
    <a class="header__logo" href={homePath(locale)} aria-label={t.ui.home}>
      <Logo variant="mark" title={t.ui.home} symbolId="owt-mark" />
    </a>

    <nav class="header__nav" aria-label="Main">
      <ul>
        {
          t.nav.map((item, i) => (
            <li class:list={{ 'has-sub': i === 0 && servicesSub.length > 0 }}>
              <a href={withBase(item.href)} data-nav-link aria-current={isCurrent(withBase(item.href)) ? 'page' : undefined}>
                {item.label}
              </a>
              {i === 0 && servicesSub.length > 0 && (
                <div class="sub">
                  <ul class="sub__list">
                    {servicesSub.map((s, k) => (
                      <li>
                        <a href={s.href} aria-current={isCurrent(s.href) ? 'page' : undefined}>
                          <span class="mono">{String(k + 1).padStart(2, '0')}</span>
                          {s.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__aside">
      <a class="header__phone" href={phones[0].href}>{phones[0].display}</a>
      <div class="header__lang" role="group" aria-label={t.ui.langLabel}>
        <a href={locale === 'uk' && !is404 ? path : homePath('uk')} aria-current={locale === 'uk' ? 'true' : undefined} lang="uk">UA</a>
        <span aria-hidden="true">/</span>
        <a href={homePath('en')} aria-current={locale === 'en' ? 'true' : undefined} lang="en">EN</a>
      </div>
      <a class="header__cta" href={requestHref} data-topic-link>
        <span>{t.ui.consult}</span>
      </a>
      <button class="header__burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
        <span class="header__burger-label">{t.ui.menu}</span>
        <span class="header__burger-lines" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div class="menu theme-ink" id="mobile-menu" data-menu hidden>
 <div class="menu__inner">
  <div class="menu__top container">
    <a class="header__logo" href={homePath(locale)} aria-label={t.ui.home}>
      <Logo variant="mark" title={t.ui.home} useId="owt-mark" />
    </a>
    <button class="menu__close" type="button" data-menu-close>
      <span>{t.ui.close}</span>
      <Icon name="close" size={22} />
    </button>
  </div>
  <nav class="menu__nav container" aria-label="Mobile">
    <ol>
      {
        t.nav.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={withBase(item.href)} data-menu-link aria-current={isCurrent(withBase(item.href)) ? 'page' : undefined}>
              <span class="mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="menu__label">{item.label}</span>
            </a>
            {i === 0 && servicesSub.length > 0 && (
              <ul class="menu__sub">
                {servicesSub.map((s) => (
                  <li>
                    <a href={s.href} data-menu-link>
                      {s.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </nav>
  <div class="menu__foot container">
    <div class="menu__phones">
      {
        phones.map((p) => (
          <a href={p.href}>{p.display}</a>
        ))
      }
    </div>
    <div class="menu__row">
      <div class="menu__msg">
        {
          messengers.map((m) => (
            <a href={m.href} aria-label={m.label} target="_blank" rel="noopener">
              <Icon name={m.id} size={22} />
            </a>
          ))
        }
      </div>
      <a class="menu__lang mono" href={homePath(other)} lang={other}>
        {other === 'en' ? 'English' : 'Українська'}
      </a>
    </div>
  </div>
 </div>
</div>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    color: var(--paper);
    transition:
      transform var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }
  .header::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--rule-on-paper);
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-out);
  }
  .header[data-state='solid'] {
    background: var(--paper);
    color: var(--ink);
  }
  .header[data-state='solid']::after {
    opacity: 1;
  }
  .header[data-state='ink'] {
    background: var(--ink);
    color: var(--paper);
  }
  .header[data-state='ink']::after {
    opacity: 1;
    background: var(--rule-on-ink);
  }
  .header__nav li {
    position: relative;
  }
  .header__nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .sub {
    position: absolute;
    top: 100%;
    left: -24px;
    padding-top: 14px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity var(--dur-1) ease,
      transform var(--dur-1) ease,
      visibility 0s linear var(--dur-1);
  }
  .has-sub:hover .sub,
  .has-sub:focus-within .sub {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .sub__list {
    display: grid;
    min-width: 290px;
    padding: 10px;
    border-radius: var(--radius-field);
    background: var(--paper);
    color: var(--ink);
    border: 1px solid var(--rule-on-paper);
    box-shadow: 0 18px 40px rgb(16 19 22 / 0.12);
  }
  .sub__list a {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 12px 14px;
    border-radius: 10px;
    font-size: 0.9375rem;
    font-weight: 450;
    transition: background-color var(--dur-1);
  }
  .sub__list a::after {
    display: none;
  }
  .sub__list a:hover,
  .sub__list a[aria-current='page'] {
    background: var(--paper-2);
  }
  .sub__list .mono {
    color: var(--on-paper-muted);
  }
  .header[data-hidden='true'] {
    transform: translateY(-100%);
  }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--header-h);
  }

  .header__logo {
    display: block;
    width: 92px;
    flex: none;
  }

  .header__nav ul {
    display: flex;
    gap: clamp(20px, 2.6vw, 44px);
  }
  .header__nav a,
  .header__phone {
    position: relative;
    font-size: 0.875rem;
    font-weight: 450;
    letter-spacing: 0;
    padding-block: 8px;
  }
  .header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .header__nav a:hover::after,
  .header__nav a[aria-current='true']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header__aside {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .header__phone {
    font-variant-numeric: tabular-nums;
  }
  .header__lang {
    display: flex;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    letter-spacing: var(--track-mono);
  }
  .header__lang a {
    opacity: 0.5;
    transition: opacity var(--dur-1);
  }
  .header__lang a:hover,
  .header__lang a[aria-current='true'] {
    opacity: 1;
  }
  .header__lang span {
    opacity: 0.35;
  }
  .header__cta {
    display: inline-flex;
    align-items: center;
    height: 42px;
    padding-inline: 20px;
    border-radius: var(--radius-o);
    border: 1px solid currentColor;
    font-size: 0.875rem;
    font-weight: 500;
    transition:
      background-color var(--dur-1),
      color var(--dur-1);
  }
  .header__cta:hover {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }
  .header[data-state='solid'] .header__cta {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .header[data-state='solid'] .header__cta:hover {
    background: var(--ink-3);
  }

  .header__burger {
    display: none;
    align-items: center;
    gap: 12px;
    height: 44px;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .header__burger-lines {
    display: grid;
    gap: 6px;
    width: 22px;
  }
  .header__burger-lines i {
    display: block;
    height: 1.5px;
    background: currentColor;
  }
  .header__burger-lines i:last-child {
    width: 14px;
    justify-self: end;
  }

  @media (max-width: 1180px) {
    .header__nav,
    .header__phone {
      display: none;
    }
  }
  @media (max-width: 767px) {
    .header__logo {
      width: 76px;
    }
    .header__lang,
    .header__cta {
      display: none;
    }
    .header__burger {
      display: inline-flex;
    }
  }
  @media (min-width: 768px) and (max-width: 1180px) {
    .header__burger {
      display: inline-flex;
    }
  }

  /* ---------- Mobile / tablet menu ---------- */
  /* Curtain reveal from the top, done with two opposing transforms (outer
     slides down, inner slides up by the same amount) so the compositor runs
     it — a clip-path curtain would repaint the page on the main thread. */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 150;
    overflow: hidden;
    transform: translate3d(0, -100%, 0);
    transition: transform 800ms var(--ease-in-out);
  }
  .menu__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow-y: auto;
    /* scrolling never chains to the page behind (no body scroll-lock: toggling
       body overflow re-lays out the whole page) */
    overscroll-behavior: contain;
    transform: translate3d(0, 100%, 0);
    transition: transform 800ms var(--ease-in-out);
  }
  .menu[hidden] {
    display: none;
  }
  .menu.is-open,
  .menu.is-open .menu__inner {
    transform: none;
  }
  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    flex: none;
  }
  .menu__close {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .menu__nav {
    flex: 1;
    display: flex;
    align-items: center;
    padding-block: 32px;
  }
  .menu__nav ol {
    width: 100%;
  }
  .menu__nav li {
    border-top: 1px solid var(--rule-on-ink);
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 700ms var(--ease-out),
      transform 900ms var(--ease-out);
    transition-delay: calc(240ms + var(--i) * 60ms);
  }
  .menu.is-open .menu__nav li {
    opacity: 1;
    transform: none;
  }
  .menu__nav a {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding-block: 14px;
  }
  .menu__nav .mono {
    color: var(--on-ink-muted);
    width: 2.5em;
  }
  .menu__nav a[aria-current='page'] .menu__label {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }
  .menu__sub {
    display: grid;
    gap: 2px;
    padding: 0 0 16px calc(2.5em + 18px);
  }
  .menu__sub a {
    display: block;
    padding: 8px 0;
    font-size: 1.0625rem;
    color: var(--on-ink-muted);
  }
  .menu__label {
    font-size: clamp(2.25rem, 9vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .menu__foot {
    flex: none;
    padding-bottom: max(28px, env(safe-area-inset-bottom));
    display: grid;
    gap: 20px;
  }
  .menu__phones {
    display: grid;
    gap: 4px;
    font-size: 1.25rem;
    font-variant-numeric: tabular-nums;
  }
  .menu__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 20px;
    border-top: 1px solid var(--rule-on-ink);
  }
  .menu__msg {
    display: flex;
    gap: 10px;
  }
  .menu__msg a {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-o);
    border: 1px solid var(--rule-on-ink);
  }
  .menu__lang {
    color: var(--on-ink-muted);
    padding: 12px 0;
  }
</style>
