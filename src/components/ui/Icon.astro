---
/** Minimal line icon set (1.5px strokes, 24px grid). */
interface Props {
  name: 'arrow' | 'arrow-down' | 'play' | 'phone' | 'telegram' | 'viber' | 'whatsapp' | 'close' | 'plus';
  class?: string;
  size?: number;
}
const { name, class: cls, size = 20 } = Astro.props;
---

<svg
  class:list={['icon', cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === 'arrow-down' && <path d="M12 4v15M6 13l6 6 6-6" />}
  {name === 'play' && <path d="M8 5.5v13l10.5-6.5L8 5.5Z" fill="currentColor" stroke="none" />}
  {name === 'phone' && (
    <path d="M6.6 3.5h3l1.5 4.2-2 1.3a11 11 0 0 0 5.9 5.9l1.3-2 4.2 1.5v3a1.6 1.6 0 0 1-1.7 1.6A16.5 16.5 0 0 1 5 5.2a1.6 1.6 0 0 1 1.6-1.7Z" stroke-linejoin="round" />
  )}
  {name === 'telegram' && <path d="m3.5 11.2 16.2-6.6-2.8 14.6-5-3.9-2.6 2.5.3-3.8 6.6-6.1-8.4 5-4.3-1.7Z" stroke-linejoin="round" />}
  {name === 'viber' && (
    <>
      <path d="M12 3.5c4.7 0 8 2.3 8 7.2s-3.3 7.2-8 7.2c-.9 0-1.8-.1-2.6-.3L6 20.5v-3.7c-1.5-1.3-2-3.3-2-6.1 0-4.9 3.3-7.2 8-7.2Z" stroke-linejoin="round" />
      <path d="M9.6 8.2c.5 2.4 2 4 4.4 4.6M12.8 7.6a2.6 2.6 0 0 1 2.2 2.2" />
    </>
  )}
  {name === 'whatsapp' && (
    <>
      <path d="M4.5 19.5 5.6 16A8 8 0 1 1 8.4 18.6l-3.9.9Z" stroke-linejoin="round" />
      <path d="M9.2 8.6c.2 2.9 2.5 5.4 5.6 5.9l.9-1.4-1.6-.9-.8.6a4.4 4.4 0 0 1-2.4-2.4l.6-.8-.9-1.6-1.4.6Z" stroke-linejoin="round" />
    </>
  )}
  {name === 'close' && <path d="M5.5 5.5l13 13M18.5 5.5l-13 13" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
</svg>

<style>
  .icon {
    flex: none;
  }
</style>
