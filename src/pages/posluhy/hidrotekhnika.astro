---
/**
 * Hydrotechnical works. All facts from owt.com.ua: services page, its
 * sub-pages (digging & cleaning, shore reinforcement, slopes, demolition)
 * and the page meta description.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import PageHead from '../../components/page/PageHead.astro';
import SubNav from '../../components/page/SubNav.astro';
import SectionHead from '../../components/page/SectionHead.astro';
import Figures from '../../components/page/Figures.astro';
import Archive from '../../components/page/Archive.astro';
import RelatedProjects from '../../components/page/RelatedProjects.astro';
import OtherDirections from '../../components/page/OtherDirections.astro';
import CtaBand from '../../components/page/CtaBand.astro';
import Button from '../../components/ui/Button.astro';
import Img from '../../components/ui/Img.astro';
import { media } from '../../data/media';
import { archive } from '../../data/archive';
import { routes } from '../../data/routes';
import { projectsFor } from '../../data/projects';

const booms = [13.5, 16.5, 18.6, 22.5];
const maxBoom = 22.5;
const equipment = [
  'Екскаватори з великим об’ємом ковша на болотних гусеницях',
  'Плаваючий екскаватор зі стрілою 16 м',
  'Екскаватор на понтоні',
  'Земснаряди та міні-земснаряди',
  'Болотні бульдозери на широких гусеницях',
  'Автомобілі КрАЗ і всюдихід «Лаптежник»',
];
const shore = [
  { n: '01', title: 'Бетонний шпунт' },
  { n: '02', title: 'Дерев’яний шпунт' },
  { n: '03', title: 'Пластиковий шпунт' },
  { n: '04', title: 'Габіони' },
  { n: '05', title: 'Тротуарна плитка' },
];
const demolition = archive('hydro-demolition');
---

<PageLayout
  headerTone="over"
  title="Гідротехнічні роботи — OWT · Ost West Technology"
  description="Комплексні гідротехнічні роботи, очищення водойм земснарядами, берегоукріплення, укріплення схилів та промисловий демонтаж будівель у Києві від компанії OWT. Договір та ПДВ."
>
  <PageHead
    theme="ink"
    layout="split"
    crumbs={[{ href: routes.home, label: 'Головна' }, { href: routes.services, label: 'Послуги' }, { label: 'Гідротехнічні роботи' }]}
    label="Напрям 01"
    title="Гідротехнічні роботи"
    lead="Комплексні гідротехнічні роботи: копка й очищення водойм земснарядами, берегоукріплення, укріплення схилів і промисловий демонтаж будівель."
    image={media.dredging}
    imageAlt="Екскаватор з довгою стрілою працює біля води — аерозйомка об’єкта OWT"
    caption="Роботи OWT — аерозйомка"
  >
    <div slot="actions" class="head-actions" data-reveal style="--d:4">
      <Button href={routes.request('hydro')} tone="light">Отримати консультацію</Button>
      <span class="mono muted">Договір та ПДВ</span>
    </div>
  </PageHead>

  <SubNav
    items={[
      { id: 'kopka', label: 'Копка та чистка водойм' },
      { id: 'bereg', label: 'Берегоукріплення' },
      { id: 'skhyly', label: 'Укріплення схилів' },
      { id: 'demontazh', label: 'Демонтаж споруд' },
      { id: 'arkhiv', label: 'Архів робіт' },
    ]}
  />

  <!-- 01 — Digging & cleaning -->
  <section class="sec theme-paper" id="kopka">
    <div class="container">
      <SectionHead
        n="01"
        label="Копка та чистка водойм"
        title="Копаємо та очищаємо водойми"
        lead="Земснаряди та міні-земснаряди розробляють усі типи ґрунтів — мул, пісок, глину, гравій."
      />
      <div class="dig grid-12">
        <div class="booms" data-reveal>
          <p class="mono muted booms__title">Екскаватори з довгою стрілою — довжина стріли, м</p>
          <ul class="booms__list">
            {
              booms.map((b) => (
                <li class="boom" style={`--w:${b / maxBoom}`}>
                  <span class="boom__bar" aria-hidden="true" />
                  <span class="boom__value">{String(b).replace('.', ',')}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="dig__list" data-reveal style="--d:1">
          <p class="mono muted">Техніка на об’єкті</p>
          <ul>
            {equipment.map((e) => <li>{e}</li>)}
          </ul>
        </div>
      </div>
      <div class="dig__figs">
        <Figures
          cols={3}
          items={[
            { value: '5–400', unit: 'м³/год', label: 'продуктивність земснарядів по ґрунту' },
            { value: '2', unit: 'км', label: 'дальність переміщення пульпи', note: 'Земснаряди та міні-земснаряди' },
            { value: '16', unit: 'м', label: 'стріла плаваючого екскаватора' },
          ]}
        />
        <ul class="soils" aria-label="Типи ґрунтів">
          {['Мул', 'Пісок', 'Глина', 'Гравій'].map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 02 — Shore reinforcement -->
  <section class="sec theme-stone" id="bereg">
    <div class="container">
      <SectionHead n="02" label="Берегоукріплення" title="П’ять способів укріплення берега" />
      <div class="shore grid-12">
        <ol class="shore__list">
          {
            shore.map((m, i) => (
              <li class="method" data-reveal style={`--d:${i}`}>
                <span class="method__n mono">{m.n}</span>
                <span class="method__title">{m.title}</span>
              </li>
            ))
          }
        </ol>
        <figure class="shore__fig" data-reveal>
          <div class="shore__img media-frame">
            <Img src={media.riprap} alt="Укріплення берега: екскаватор з довгою стрілою та кам’яне накидання" widths={[640, 960, 1280, 1600]} sizes="(min-width: 1024px) 40vw, 100vw" />
          </div>
          <figcaption class="mono muted">Берегоукріплення — роботи OWT</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 03 / 04 — Slopes & demolition -->
  <section class="sec theme-paper">
    <div class="container duo">
      <article class="card" id="skhyly" data-reveal>
        <p class="mono muted">03 — Укріплення схилів</p>
        <h2 class="h3">Укріплення схилів</h2>
        <p class="muted card__text">Окремий вид гідротехнічних робіт OWT. Розрахуємо рішення під ваш об’єкт після консультації інженера.</p>
        <a class="card__link" href={routes.request('hydro')}>Обговорити об’єкт</a>
      </article>
      <article class="card card--photo" id="demontazh" data-reveal style="--d:1">
        <div class="card__media media-frame">
          <Img src={demolition[0]} alt="Демонтаж будівлі екскаватором — роботи OWT" widths={[320, 640]} sizes="(min-width: 1024px) 40vw, 100vw" />
        </div>
        <p class="mono muted">04 — Демонтаж споруд</p>
        <h2 class="h3">Демонтаж споруд</h2>
        <p class="muted card__text">Промисловий демонтаж будівель і споруд.</p>
        <a class="card__link" href={routes.request('hydro')}>Обговорити об’єкт</a>
      </article>
    </div>
  </section>

  <!-- 05 — Archive -->
  <section class="sec theme-ink" id="arkhiv">
    <div class="container">
      <SectionHead n="05" label="Архів робіт" title="З об’єктів OWT" lead="Фото з галерей гідротехнічних робіт OWT." />
      <Archive
        groups={[
          { title: 'Копка та чистка водойм', images: archive('hydro-dig') },
          { title: 'Берегоукріплення', images: archive('hydro-shore') },
        ]}
      />
    </div>
  </section>

  <RelatedProjects n="06" items={projectsFor('hydro')} theme="paper" />
  <OtherDirections n="07" current="hydro" />
  <CtaBand
    topic="hydro"
    title="Розкажіть про вашу водойму чи берег"
    text="Інженер OWT проаналізує задачу та зорієнтує щодо бюджету і строків. Працюємо за договором, з ПДВ."
  />
</PageLayout>

<style>
  .head-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 12px;
  }
  .sec {
    padding-block: var(--section-pad);
  }

  /* booms chart */
  .dig {
    row-gap: 48px;
  }
  .booms {
    grid-column: 1 / span 7;
  }
  .booms__title {
    padding-bottom: 16px;
    border-bottom: 1px solid var(--rule-on-paper);
  }
  .booms__list {
    display: grid;
    gap: 14px;
    padding-top: 20px;
  }
  .boom {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.5em;
    align-items: center;
    gap: 16px;
  }
  .boom__bar {
    display: block;
    height: 14px;
    border-radius: 999px;
    background: var(--ink);
    width: calc(var(--w) * 100%);
    transform-origin: left;
    transition: transform 1600ms var(--ease-out);
  }
  :global(.js) .booms:not(.is-in) .boom__bar {
    transform: scaleX(0);
  }
  .boom:nth-child(2) .boom__bar {
    transition-delay: 120ms;
  }
  .boom:nth-child(3) .boom__bar {
    transition-delay: 240ms;
  }
  .boom:nth-child(4) .boom__bar {
    transition-delay: 360ms;
  }
  .boom__value {
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    font-weight: 450;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .dig__list {
    grid-column: 9 / -1;
  }
  .dig__list ul {
    margin-top: 16px;
    border-top: 1px solid var(--rule-on-paper);
  }
  .dig__list li {
    padding: 14px 0;
    border-bottom: 1px solid var(--rule-on-paper);
    font-size: 1rem;
  }
  .dig__figs {
    margin-top: clamp(56px, 7vw, 104px);
  }
  .soils {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }
  .soils li {
    padding: 10px 18px;
    border-radius: var(--radius-o);
    background: var(--ink);
    color: var(--paper);
    font-size: 0.9375rem;
  }

  /* shore methods */
  .shore {
    row-gap: 40px;
    align-items: start;
  }
  .shore__list {
    grid-column: 1 / span 6;
    border-top: 1px solid var(--rule-on-paper);
  }
  .method {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: clamp(18px, 2.2vw, 28px) 0;
    border-bottom: 1px solid var(--rule-on-paper);
  }
  .method__n {
    color: var(--on-paper-muted);
  }
  .method__title {
    font-size: clamp(1.5rem, 2.8vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .shore__fig {
    grid-column: 8 / -1;
    display: grid;
    gap: 14px;
    position: sticky;
    top: calc(var(--header-h) + 80px);
  }
  .shore__img {
    aspect-ratio: 4 / 5;
  }

  /* duo cards */
  .duo {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--col-gap);
    align-items: stretch;
  }
  .card {
    display: grid;
    align-content: start;
    gap: 18px;
    padding: clamp(24px, 3vw, 44px);
    border-radius: var(--radius-panel);
    border: 1px solid var(--rule-on-paper);
    scroll-margin-top: 140px;
  }
  .card__media {
    aspect-ratio: 16 / 10;
    margin-bottom: 8px;
  }
  .card__text {
    max-width: 40ch;
    font-size: 1.0625rem;
  }
  .card__link {
    justify-self: start;
    margin-top: 8px;
    padding-bottom: 4px;
    font-weight: 500;
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
  }

  @media (max-width: 1023px) {
    .booms,
    .dig__list,
    .shore__list,
    .shore__fig {
      grid-column: 1 / -1;
    }
    .shore__fig {
      position: static;
    }
    .shore__img {
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 767px) {
    .duo {
      grid-template-columns: 1fr;
    }
    .head-actions :global(.btn) {
      width: 100%;
      justify-content: space-between;
    }
    .boom__bar {
      height: 10px;
    }
  }
</style>
