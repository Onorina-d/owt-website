---
/**
 * Work archive: small real photos from the old site’s service galleries.
 * The originals are 640×400, so tiles never get larger than ~320 CSS px.
 */
import type { ImageMetadata } from 'astro';
import Img from '../ui/Img.astro';

interface Props {
  groups: { title: string; images: ImageMetadata[] }[];
}
const { groups } = Astro.props;
---

<div class="archive">
  {
    groups.map((g) => (
      <div class="archive__group">
        <p class="archive__title mono">
          <span>{g.title}</span>
          <span class="muted">{String(g.images.length).padStart(2, '0')} фото</span>
        </p>
        <ul class="archive__grid">
          {g.images.map((img, i) => (
            <li class="archive__tile media-frame" data-reveal style={`--d:${i % 4}`}>
              <Img src={img} alt={`${g.title} — фото з об’єкта OWT`} widths={[320, 640]} sizes="(min-width: 1024px) 22vw, 46vw" />
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .archive {
    display: grid;
    gap: clamp(40px, 5vw, 72px);
  }
  .archive__title {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    margin-bottom: 18px;
    border-bottom: 1px solid var(--rule);
  }
  .archive__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(8px, 1vw, 16px);
  }
  .archive__tile {
    aspect-ratio: 16 / 10;
  }
  @media (max-width: 767px) {
    .archive__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
