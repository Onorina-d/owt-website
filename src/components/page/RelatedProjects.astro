---
/** Contextual block: completed projects relevant to the current page. */
import SectionHead from './SectionHead.astro';
import ProjectCard from './ProjectCard.astro';
import { projects as all, type Project } from '../../data/projects';
import { routes } from '../../data/routes';
import Icon from '../ui/Icon.astro';

interface Props {
  items: Project[];
  n: string;
  title?: string;
  theme?: 'ink' | 'paper' | 'stone';
}
const { items, n, title = 'Реалізовані проєкти', theme = 'ink' } = Astro.props;
const indexOf = (p: Project) => all.findIndex((x) => x.slug === p.slug) + 1;
---

{
  items.length > 0 && (
    <section class:list={['related', `theme-${theme}`]}>
      <div class="container">
        <SectionHead n={n} label="Проєкти" title={title} />
        <div class:list={['related__grid', { 'related__grid--one': items.length === 1 }]}>
          {items.map((p, i) => (
            <div class="related__item" data-reveal style={`--d:${i % 2}`}>
              <ProjectCard project={p} index={indexOf(p)} />
            </div>
          ))}
        </div>
        <a class="related__all" href={routes.projects}>
          Усі проєкти
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </section>
  )
}

<style>
  .related {
    padding-block: var(--section-pad);
  }
  .related__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(48px, 6vw, 96px) clamp(24px, 3vw, 56px);
  }
  .related__item:nth-child(even) {
    margin-top: clamp(0px, 8vw, 140px);
  }
  .related__grid--one {
    grid-template-columns: minmax(0, 0.66fr);
  }
  .related__all {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: clamp(48px, 6vw, 80px);
    padding-bottom: 4px;
    font-weight: 500;
    background: linear-gradient(currentColor, currentColor) 0 100% / 100% 1px no-repeat;
  }
  @media (max-width: 767px) {
    .related__grid,
    .related__grid--one {
      grid-template-columns: 1fr;
    }
    .related__item:nth-child(even) {
      margin-top: 0;
    }
  }
</style>
